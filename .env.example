# Dolynglish backend environment
# Copy this file to .env (gitignored) and fill in real values

# ===== App =====
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
API_PREFIX=api/v1
APP_NAME=dolynglish-backend
# Versión ÚNICA de la aplicación (la que compone versions.yml). La inyecta
# el despliegue; sin ella se usa la versión de este repositorio.
# APP_VERSION=
# Qué pieza de la aplicación es este proceso.
COMPONENT=dolynation-atl-back
# Momento de la construcción del artefacto (lo inyecta el build de la
# imagen). Sin ella se usa la hora de arranque del proceso.
# BUILT_AT=
# Commit de build (lo inyecta el Dockerfile).
GIT_COMMIT=unknown

# ===== Database =====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dolynglish_user
DB_PASSWORD=
DB_DATABASE=dolynglish_test
DB_LOGGING=false

# ===== Auth (JWT) =====
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=5m
JWT_REFRESH_TTL=30d

# ===== AI providers =====
# Active provider. Available: minimax, google
AI_DEFAULT_PROVIDER=minimax

# MiniMax (OpenAI-compatible chat completions)
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_ENDPOINT=https://api.minimax.io/v1/chat/completions
MINIMAX_TIMEOUT_MS=90000
MINIMAX_MAX_TOKENS=8192
MINIMAX_TEMPERATURE=0.7
MINIMAX_REASONING_EFFORT=low

# Google AI Studio / Gemini (Free Tier available; default model gemini-3.5-flash-lite is configured automatically,
# and GOOGLE_API_KEY also unlocks gemini-decision-1 for 0-output-token category moderation)
GOOGLE_API_KEY=

# Groq (legacy provider — kept for reference, not active by default)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# ===== Category Moderation & Daily Anti-Abuse Quota =====
CATEGORY_MODERATION_ENABLED=true
CATEGORY_MODERATION_AI_ENABLED=true
# auto | openai | google-decisions | minimax | google | none
# (`auto` tries free OpenAI Moderation if keyed, then gemini-decision-1 if GOOGLE_API_KEY exists, before generative AI)
CATEGORY_MODERATION_AI_PROVIDER=auto
# Límite diario de categorías dinámicas distintas evaluadas por usuario (reseteo America/Mexico_City)
CATEGORY_DAILY_LIMIT=20
CATEGORY_MODERATION_SCORE_THRESHOLD=0.45
CATEGORY_MODERATION_TIMEOUT_MS=15000
CATEGORY_MODERATION_CACHE_TTL_MS=86400000
# OpenAI Moderation API is free ($0.00/call with omni-moderation-latest) if a key is provided
OPENAI_API_KEY=
OPENAI_MODERATION_ENDPOINT=https://api.openai.com/v1/moderations
OPENAI_MODERATION_MODEL=omni-moderation-latest

# ─────────────────────────────────────────────────────────────────────────────
# Correo (SMTP)
#
# Opcionales: sin ellas la app arranca igual y el servicio de correo falla con
# un mensaje claro ("falta SMTP_HOST/SMTP_USER") cuando se intenta enviar.
#
# El cliente SMTP es agnóstico del proveedor: Mailtrap, Brevo y Mailpit
# funcionan sin cambiar una línea de código. Lo único que cambia son los
# valores de estas variables.
#
# En local, lo mas comodo es un catcher (no necesita ninguna clave real):
#   docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_USER=
#   SMTP_PASSWORD=
# y se ve el correo en http://localhost:8025
#
# En desarrollo se usa Mailtrap Sandbox (captura el correo, no llega a buzones
# reales):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=<usuario del sandbox>
#   SMTP_PASSWORD=<contraseña del sandbox>
#
# En staging y produccion se usa Brevo (host smtp-relay.brevo.com, puerto 587).
# Ojo: la contraseña es la **SMTP key** de Brevo, no la API key.
#
# En develop, staging y produccion los valores los pone el scrum master como
# secrets del GitHub Environment correspondiente: cada ambiente tiene claves
# distintas. Si usas tu propio SMTP en local, pon aqui los tuyos.
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_SECURE=false

# Base publica del frontend: se usa para construir los enlaces de los correos
# (confirmacion de cuenta y restablecimiento de contrasena).
FRONTEND_BASE_URL=http://localhost:3000

# Cuando es `true`, iniciar sesion exige que el usuario haya confirmado su
# correo. Desactivado por defecto; se activa en produccion.
EMAIL_VERIFICATION_REQUIRED=false

# ===== Solicitudes de acceso y aprobacion administrativa =====
# Cuando es `true`, seleccionar un plan o desbloquear cambio de idioma entra en
# lista de espera hasta que un administrador lo apruebe y notifique por correo.
# Cuando es `false`, las solicitudes se deshabilitan y vuelve la activacion directa.
ACCESS_REQUESTS_ENABLED=true
# Correo opcional para recibir aviso cuando un usuario envia una solicitud nueva.
ADMIN_NOTIFICATION_EMAIL=

# ===== Pagos y facturacion (Stripe Sandbox / manual) =====
# `manual` mantiene el flujo local/CI sin cobros externos; `stripe` activa checkout y webhooks.
BILLING_PROVIDER=manual
BILLING_ENV_TAG=local
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=mxn
# `custom` habilita Stripe PaymentElement + Appearance API (100% UI DolyNation); `hosted` usa pagina externa de Stripe.
STRIPE_CHECKOUT_UI_MODE=custom
# Dejar vacio cuando `dolly` es gratuito ($0).
STRIPE_PRICE_DOLLY=
STRIPE_PRICE_DOLLY_PLUS=
STRIPE_PRICE_DOLLY_PRO=
STRIPE_PRICE_LANGUAGE_UNLOCK=

# ===== OAuth 2.0 / OIDC (Google; extensible a Microsoft) =====
# Opcionales: si quedan vacias, el inicio de sesion con Google permanece deshabilitado.
# Si GOOGLE_OAUTH_REDIRECT_URI se omite, se deriva de ${FRONTEND_BASE_URL}/api/auth/oauth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
