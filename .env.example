# Dolynglish backend environment
# Copy this file to .env (gitignored) and fill in real values

# ===== App =====
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
API_PREFIX=api/v1
APP_NAME=dolynglish-backend
# Versión ÚNICA de la aplicación (la que compone versions.yml). La inyecta
# el despliegue; sin ella se usa la versión de este repositorio.
# APP_VERSION=
# Qué pieza de la aplicación es este proceso.
COMPONENT=dolynation-atl-back
# Momento de la construcción del artefacto (lo inyecta el build de la
# imagen). Sin ella se usa la hora de arranque del proceso.
# BUILT_AT=
# Commit de build (lo inyecta el Dockerfile).
GIT_COMMIT=unknown

# ===== Database =====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dolynglish_user
DB_PASSWORD=
DB_DATABASE=dolynglish_test
DB_LOGGING=false

# ===== Auth (JWT) =====
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=5m
JWT_REFRESH_TTL=30d

# ===== AI providers =====
# Active provider. Available: minimax, groq
AI_DEFAULT_PROVIDER=minimax

# MiniMax M3 (OpenAI-compatible chat completions)
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_ENDPOINT=https://api.minimax.io/v1/chat/completions
MINIMAX_TIMEOUT_MS=90000
MINIMAX_MAX_TOKENS=8192
MINIMAX_TEMPERATURE=0.6
MINIMAX_REASONING_EFFORT=low

# Groq (legacy provider — kept for reference, not active by default)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# ===== Category Moderation & Daily Anti-Abuse Quota =====
CATEGORY_MODERATION_ENABLED=true
CATEGORY_MODERATION_AI_ENABLED=true
# auto | openai | minimax | none (openai utiliza únicamente el endpoint gratuito /v1/moderations)
CATEGORY_MODERATION_AI_PROVIDER=auto
# Límite diario de categorías dinámicas distintas evaluadas por usuario (reseteo America/Mexico_City)
CATEGORY_DAILY_LIMIT=20
CATEGORY_MODERATION_SCORE_THRESHOLD=0.45
CATEGORY_MODERATION_TIMEOUT_MS=5000
CATEGORY_MODERATION_CACHE_TTL_MS=86400000
# OpenAI Moderation API is free ($0.00/call with omni-moderation-latest) if a key is provided
OPENAI_API_KEY=
OPENAI_MODERATION_ENDPOINT=https://api.openai.com/v1/moderations
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Google Perspective API (optional free tier)
PERSPECTIVE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Correo (SMTP)
#
# Opcionales: sin ellas la app arranca igual y el servicio de correo falla con
# un mensaje claro ("falta SMTP_HOST/SMTP_USER") cuando se intenta enviar.
#
# En local, lo mas comodo es un catcher (no necesita ninguna clave real):
#   docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_USER=
#   SMTP_PASSWORD=
# y se ve el correo en http://localhost:8025
#
# En develop, staging y produccion los valores los pone el scrum master como
# secrets del GitHub Environment correspondiente: cada ambiente tiene claves
# distintas. Si usas tu propio SMTP en local, pon aqui los tuyos.
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_SECURE=false
