{
  "name": "DolyNation — Backend (Atl)",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "usernamehere.github-vscode-remotes"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },
  "forwardPorts": [
    3333,
    5432
  ],
  "portsAttributes": {
    "3333": {
      "label": "API NestJS",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "npm ci && cp -n .env.example .env || true",
  "postStartCommand": "echo 'Listo. Para la BD: docker compose -f ../dolynation-tlalli-infra/docker-compose.test.yml up -d'",
  "remoteUser": "node"
}
